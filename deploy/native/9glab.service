[Unit]
Description=9gLab canvas backend
After=network-online.target postgresql.service 9glab-redis.service
Wants=network-online.target
Requires=9glab-redis.service

[Service]
Type=simple
User=9glab
Group=9glab
WorkingDirectory=/opt/9glab/current
EnvironmentFile=/etc/9glab/production.env
ExecStart=/opt/9glab/current/bin/server
Restart=on-failure
RestartSec=5
TimeoutStopSec=660
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/9glab/data
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
